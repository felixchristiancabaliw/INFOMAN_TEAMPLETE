// HOMEPAGE (Hope, Inc. ERP)

// Footer year updates automatically
document.getElementById("year").textContent = new Date().getFullYear();

// If the visitor is already signed in, show dashboard shortcuts instead of Sign In / Register
const user = sessionStorage.getItem("hopeUser") || localStorage.getItem("hopeUser");

if (user) {
    const navLogin = document.getElementById("navLogin");
    navLogin.textContent = "Dashboard";
    navLogin.href = "dashboard.html";

    const navRegister = document.getElementById("navRegister");
    navRegister.textContent = "Log out";
    navRegister.href = "#";
    navRegister.addEventListener("click", e => {
        e.preventDefault();
        sessionStorage.removeItem("hopeUser");
        localStorage.removeItem("hopeUser");
        window.location.reload();
    });

    const heroLogin = document.getElementById("heroLogin");
    heroLogin.textContent = "Go to dashboard";
    heroLogin.href = "dashboard.html";

    document.getElementById("heroRegister").style.display = "none";
}
