-- 1. Gumawa ng append-only `audit_log` table (tugma sa HopeDB_audit.sql)
CREATE TABLE IF NOT EXISTS audit_log (
    audit_id    BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    table_name  VARCHAR(50) NOT NULL,
    action      VARCHAR(10) NOT NULL CHECK (action IN ('ADD','EDIT','DELETE','RESTORE')),
    record_key  TEXT,
    old_values  JSONB,
    new_values  JSONB,
    action_by   TEXT NOT NULL,
    action_at   TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- I-disable ang RLS para mabasa kung i-query ng frontend o API
ALTER TABLE audit_log DISABLE ROW LEVEL SECURITY;

-- 2. Trigger function na safe para sa Supabase schema at website ninyo
CREATE OR REPLACE FUNCTION trg_supabase_audit_log() RETURNS TRIGGER
LANGUAGE plpgsql AS $$
DECLARE
    v_action TEXT;
    v_key    TEXT;
    v_user   TEXT;
BEGIN
    v_user := COALESCE(
        NULLIF(current_setting('request.jwt.claim.email', true), ''),
        NULLIF(current_setting('app.username', true), ''),
        session_user::text
    );

    IF TG_OP = 'INSERT' THEN
        v_key := to_jsonb(NEW) ->> 'id';
        INSERT INTO audit_log (table_name, action, record_key, old_values, new_values, action_by)
        VALUES (TG_TABLE_NAME, 'ADD', v_key, NULL, to_jsonb(NEW), v_user);
        RETURN NEW;

    ELSIF TG_OP = 'UPDATE' THEN
        v_key := to_jsonb(NEW) ->> 'id';
        IF (to_jsonb(OLD) ? 'is_deleted') THEN
            IF NOT COALESCE((to_jsonb(OLD) ->> 'is_deleted')::boolean, false)
               AND COALESCE((to_jsonb(NEW) ->> 'is_deleted')::boolean, false) THEN
                v_action := 'DELETE';
            ELSIF COALESCE((to_jsonb(OLD) ->> 'is_deleted')::boolean, false)
               AND NOT COALESCE((to_jsonb(NEW) ->> 'is_deleted')::boolean, false) THEN
                v_action := 'RESTORE';
            ELSE
                v_action := 'EDIT';
            END IF;
        ELSIF (to_jsonb(OLD) ? 'status') AND (to_jsonb(NEW) ->> 'status') = 'Inactive' AND (to_jsonb(OLD) ->> 'status') <> 'Inactive' THEN
            v_action := 'DELETE';
        ELSE
            v_action := 'EDIT';
        END IF;

        INSERT INTO audit_log (table_name, action, record_key, old_values, new_values, action_by)
        VALUES (TG_TABLE_NAME, v_action, v_key, to_jsonb(OLD), to_jsonb(NEW), v_user);
        RETURN NEW;

    ELSIF TG_OP = 'DELETE' THEN
        v_key := to_jsonb(OLD) ->> 'id';
        INSERT INTO audit_log (table_name, action, record_key, old_values, new_values, action_by)
        VALUES (TG_TABLE_NAME, 'DELETE', v_key, to_jsonb(OLD), NULL, v_user);
        RETURN OLD;
    END IF;
    RETURN NULL;
END;
$$;

-- 3. Ikabit ang audit trigger sa lahat ng active tables ng website ninyo
DO $$
DECLARE
    t TEXT;
BEGIN
    FOREACH t IN ARRAY ARRAY[
        'customers', 'products', 'price_history',
        'departments', 'jobs', 'employees',
        'sales', 'sale_items', 'payments', 'user_profiles'
    ]
    LOOP
        EXECUTE format('DROP TRIGGER IF EXISTS %I ON %I', t || '_audit_trg', t);
        EXECUTE format('CREATE TRIGGER %I AFTER INSERT OR UPDATE OR DELETE ON %I
                        FOR EACH ROW EXECUTE FUNCTION trg_supabase_audit_log()',
                       t || '_audit_trg', t);
    END LOOP;
END;
$$;

