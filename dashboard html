<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HOPE, Inc. ERP Dashboard</title>
    <link rel="stylesheet" href="dashboard.css">
</head>

<body>

<div class="layout">

    <!-- Sidebar -->
    <aside class="sidebar">

        <div class="logo">
            <div class="logo-icon">H</div>
            <span>Hope, Inc. ERP</span>
        </div>

        <nav class="navigation">
            <a href="#" class="nav-link active" data-view="dashboard"><span class="nav-icon">⌂</span> Dashboard</a>

            <p class="module-label">Modules</p>

            <a href="#" class="nav-link" data-view="customers"><span class="nav-icon">👥</span> Customers</a>
            <a href="#" class="nav-link" data-view="products"><span class="nav-icon">♧</span> Products</a>
            <a href="#" class="nav-link" data-view="sales"><span class="nav-icon">📈</span> Sales</a>
            <a href="#" class="nav-link" data-view="reports"><span class="nav-icon">▤</span> Reports</a>
        </nav>

        <div class="sidebar-bottom">
            <div class="profile">
                <div class="profile-icon">♙</div>
                <div class="profile-name">
                    <strong id="userName">Name</strong>
                    <small>USER</small>
                </div>
                <button class="logout" onclick="logout()">Logout</button>
            </div>
        </div>

    </aside>

    <!-- Main Dashboard -->
    <main class="main">

        <header class="topbar">
            <h1>Dashboard</h1>
            <span class="user-badge">USER</span>
        </header>

        <div class="content">

<div id="view-dashboard" class="view">

            <section class="welcome">
                <h2 id="welcomeText">Welcome back, User!</h2>
                <p>
                    You have access to the core modules assigned to you.
                    Contact an Admin for elevated permissions.
                </p>
            </section>

            <section class="stats">
                <div class="stat-card">
                    <p>Total Customers</p>
                    <h3 id="statCustomers">0</h3>
                    <small id="statInactive"></small>
                </div>
                <div class="stat-card">
                    <p>Products</p>
                    <h3 id="statProducts">0</h3>
                    <small id="noteProducts"></small>
                </div>
                <div class="stat-card">
                    <p>Open Orders</p>
                    <h3 id="statOrders">0</h3>
                    <small id="noteOrders"></small>
                </div>
                <div class="stat-card">
                    <p>Revenue (MTD)</p>
                    <h3 id="statRevenue">$0</h3>
                    <small id="noteRevenue"></small>
                </div>
            </section>

            <section class="quick-actions">
                <h2>Quick Actions</h2>
                <div class="action-buttons">
                    <a href="#" data-view="customers">View Customers</a>
                    <a href="#" data-view="products">Manage Products</a>
                    <a href="#" data-view="hr">Human Resources</a>
                    <a href="#" data-view="sales">Sales Pipeline</a>
                    <a href="#" data-view="reports">Reports</a>
                </div>
            </section>
</div>

<div id="view-customers" class="view" hidden><h2 class="view-title">Customers</h2><div id="customersTable"></div></div>
<div id="view-products" class="view" hidden><h2 class="view-title">Products</h2><div id="productsTable"></div></div>
<div id="view-sales" class="view" hidden><h2 class="view-title">Sales</h2><div id="salesTable"></div></div>
<div id="view-reports" class="view" hidden><h2 class="view-title">Reports</h2><div id="reportsBox"></div></div>
<div id="view-hr" class="view" hidden><h2 class="view-title">Human Resources</h2><p>This module is not set up yet.</p></div>

        </div>

    </main>

</div>

<script src="dashboard.js"></script>
</body>
</html>
