// ---- Sample data (replace with API calls later) ----
const customers = [
  { id: 1, name: "Maria Santos",  email: "maria@example.com",  active: true },
  { id: 2, name: "John Reyes",    email: "john@example.com",   active: true },
  { id: 3, name: "Ana Cruz",      email: "ana@example.com",    active: false },
  { id: 4, name: "Paolo Garcia",  email: "paolo@example.com",  active: true },
  { id: 5, name: "Liza Mendoza",  email: "liza@example.com",   active: true }
];
const products = [
  { id: 1, name: "Notebook",  price: 120, stock: 200 },
  { id: 2, name: "Pen Set",   price: 80,  stock: 350 },
  { id: 3, name: "Backpack",  price: 950, stock: 40 },
  { id: 4, name: "Desk Lamp", price: 600, stock: 0 }
];
const sales = [
  { id: 101, customerId: 1, product: "Notebook",  qty: 10, status: "Completed" },
  { id: 102, customerId: 2, product: "Backpack",  qty: 2,  status: "Open" },
  { id: 103, customerId: 4, product: "Pen Set",   qty: 25, status: "Completed" },
  { id: 104, customerId: 5, product: "Desk Lamp", qty: 3,  status: "Open" }
];

// ---- Helpers ----
const $ = id => document.getElementById(id);
const money = n => "₱" + n.toLocaleString();
const priceOf = name => products.find(p => p.name === name).price;
const customerName = id => customers.find(c => c.id === id).name;

function table(headers, rows) {
  return `<table class="data-table"><thead><tr>${headers.map(h => `<th>${h}</th>`).join("")}</tr></thead>` +
         `<tbody>${rows.map(r => `<tr>${r.map(c => `<td>${c}</td>`).join("")}</tr>`).join("")}</tbody></table>`;
}

// ---- Login check ----
const user = sessionStorage.getItem("hopeUser") || localStorage.getItem("hopeUser");
if (!user) window.location.href = "login.html";

function logout() {
  if (confirm("Are you sure you want to log out?")) {
    sessionStorage.removeItem("hopeUser");
    localStorage.removeItem("hopeUser");
    window.location.href = "login.html";
  }
}

// ---- Fill in page ----
$("userName").textContent = user;
$("welcomeText").textContent = `Welcome back, ${user}!`;

// Dashboard summary cards (edit these values, or connect them to real data later)
const stats = {
  customers: 5,   customersNote: "1 inactive",
  products: 400,  productsNote: "\u2191 7 new this week",
  orders: 100,    ordersNote: "\u2191 10% vs last week",
  revenue: "$99.1k", revenueNote: "\u2191 20% vs last month"
};
$("statCustomers").textContent = stats.customers;
$("statInactive").textContent = stats.customersNote;
$("statProducts").textContent = stats.products;
$("noteProducts").textContent = stats.productsNote;
$("statOrders").textContent = stats.orders;
$("noteOrders").textContent = stats.ordersNote;
$("statRevenue").textContent = stats.revenue;
$("noteRevenue").textContent = stats.revenueNote;

const completed = sales.filter(s => s.status === "Completed");
const revenue = completed.reduce((sum, s) => sum + s.qty * priceOf(s.product), 0);

$("customersTable").innerHTML = table(["ID", "Name", "Email", "Status"],
  customers.map(c => [c.id, c.name, c.email,
    c.active ? '<span class="badge-ok">Active</span>' : '<span class="badge-off">Inactive</span>']));
$("productsTable").innerHTML = table(["ID", "Name", "Price", "Stock"],
  products.map(p => [p.id, p.name, money(p.price), p.stock === 0 ? '<span class="badge-off">Out of stock</span>' : p.stock]));
$("salesTable").innerHTML = table(["Order", "Customer", "Product", "Qty", "Total", "Status"],
  sales.map(s => [s.id, customerName(s.customerId), s.product, s.qty, money(s.qty * priceOf(s.product)), s.status]));
$("reportsBox").innerHTML = `<div class="report-box">
  Total revenue (completed): <b>${money(revenue)}</b><br>
  Open orders: <b>${sales.filter(s => s.status === "Open").length}</b><br>
  Out-of-stock products: <b>${products.filter(p => p.stock === 0).length}</b><br>
  Active customers: <b>${customers.filter(c => c.active).length}</b></div>`;

// ---- Navigation between views ----
function showView(name) {
  document.querySelectorAll(".view").forEach(v => v.hidden = v.id !== "view-" + name);
  document.querySelectorAll(".nav-link").forEach(l => l.classList.toggle("active", l.dataset.view === name));
}
document.querySelectorAll("[data-view]").forEach(el =>
  el.addEventListener("click", e => { e.preventDefault(); showView(el.dataset.view); }));
