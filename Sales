cust_numbered AS (
  SELECT id, ROW_NUMBER() OVER (ORDER BY created_at ASC) AS rn
  FROM customers
),
item_totals AS (
  SELECT sale_id, COALESCE(SUM(line_total), 0) AS total_amt
  FROM sale_items
  GROUP BY sale_id
),
pay_totals AS (
  SELECT sale_id, COALESCE(SUM(amount), 0) AS paid_amt
  FROM payments
  GROUP BY sale_id
)
INSERT INTO sales (id, customer_id, sale_date, total_amount, balance, payment_status, created_at)
SELECT
  ss.sale_uuid::uuid,
  cn.id,
  COALESCE((SELECT MIN(p.payment_date) FROM payments p WHERE p.sale_id = ss.sale_uuid::uuid), ss.s_date::date),
  COALESCE(it.total_amt, 0),
  GREATEST(0, COALESCE(it.total_amt, 0) - COALESCE(pt.paid_amt, 0)),
  CASE
    WHEN COALESCE(pt.paid_amt, 0) >= COALESCE(it.total_amt, 0) AND COALESCE(it.total_amt, 0) > 0 THEN 'Paid'
    WHEN COALESCE(pt.paid_amt, 0) > 0 THEN 'Partial'
    ELSE 'Unpaid'
  END,
  (ss.s_date || ' 08:00:00+00')::timestamptz
FROM sales_seed ss
LEFT JOIN cust_numbered cn ON cn.rn = ((RIGHT(ss.cust_code, 3)::int - 1) % GREATEST((SELECT COUNT(*) FROM customers), 1)) + 1
LEFT JOIN item_totals it ON it.sale_id = ss.sale_uuid::uuid
LEFT JOIN pay_totals pt ON pt.sale_id = ss.sale_uuid::uuid
ON CONFLICT (id) DO NOTHING;

-- 4. I-add ang Foreign Keys sa sale_items at payments para kumpleto ang schema
ALTER TABLE sale_items
  DROP CONSTRAINT IF EXISTS fk_sale_items_sale,
  ADD CONSTRAINT fk_sale_items_sale FOREIGN KEY (sale_id) REFERENCES sales(id) ON DELETE CASCADE;

ALTER TABLE payments
  DROP CONSTRAINT IF EXISTS fk_payments_sale,
  ADD CONSTRAINT fk_payments_sale FOREIGN KEY (sale_id) REFERENCES sales(id) ON DELETE CASCADE;
