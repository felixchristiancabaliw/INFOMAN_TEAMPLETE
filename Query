-- 1. Index para mabilis hanapin ang presyo base sa product at petsa
create index if not exists idx_price_history_prod_date on public.price_history (product_id, effective_date desc);

-- 2. Function/Query para kunin ang tamang presyo as of a given date
create or replace function public.get_product_price_as_of(p_product_id uuid, p_as_of_date date default current_date)
returns numeric(12,2)
language sql
stable
as $$
  select coalesce(
    (
      select ph.new_price
      from public.price_history ph
      where ph.product_id = p_product_id
        and ph.effective_date <= p_as_of_date
      order by ph.effective_date desc, ph.created_at desc
      limit 1
    ),
    (
      select p.unit_price
      from public.products p
      where p.id = p_product_id
    ),
    0.00
  );
$$;
