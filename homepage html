<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HOPE, Inc. ERP</title>
    <link rel="stylesheet" href="homepage.css">
</head>
<body>

    <header>
        <div class="logo">
            <div class="logo-icon">H</div>
            <h1>HOPE, Inc. ERP</h1>
        </div>
        <nav class="header-buttons">
            <a href="login.html" id="navLogin">Sign In</a>
            <a href="register.html" id="navRegister">Register</a>
        </nav>
    </header>

    <main class="hero">
        <section class="hero-content">
            <p class="tagline">A simpler way to stay organized.</p>
            <h2>Manage Your Business,<br><strong>Made Simple.</strong></h2>
            <p class="description">
                Hope, Inc. ERP helps you manage customers, products, employees,<br>
