                Stay organized, track your business activities, and manage your daily operations with ease.
            </p>
            <div class="hero-buttons">
                <a href="login.html" id="heroLogin">Sign In to dashboard</a>
                <a href="register.html" class="register-button" id="heroRegister">Register</a>
            </div>
        </section>

        <section class="dashboard">
            <div class="dashboard-heading">
                <span>Workspace overview</span>
                <span>HOPE, Inc. ERP Dashboard</span>
            </div>
            <div class="dashboard-grid">
                <div class="dashboard-card"><h3>Customers</h3><p>Manage contacts<br>&amp; accounts</p></div>
                <div class="dashboard-card"><h3>Products</h3><p>Catalog &amp; inventory</p></div>
                <div class="dashboard-card"><h3>Human Resources</h3><p>Employees &amp; payroll</p></div>
                <div class="dashboard-card"><h3>Sales</h3><p>Orders &amp; revenue</p></div>
            </div>
        </section>
    </main>

    <footer>
        <p>&copy; <span id="year">2026</span> Hope, Inc. ERP System &middot; All rights reserved</p>
    </footer>

